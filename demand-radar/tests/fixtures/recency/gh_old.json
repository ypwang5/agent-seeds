ocked":false,"assignees":[{"login":"MarcSerraPeralta","id":43704266,"node_id":"MDQ6VXNlcjQzNzA0MjY2","avatar_url":"https://avatars.githubusercontent.com/u/43704266?v=4","gravatar_id":"","url":"https://api.github.com/users/MarcSerraPeralta","html_url":"https://github.com/MarcSerraPeralta","followers_url":"https://api.github.com/users/MarcSerraPeralta/followers","following_url":"https://api.github.com/users/MarcSerraPeralta/following{/other_user}","gists_url":"https://api.github.com/users/MarcSerraPeralta/gists{/gist_id}","starred_url":"https://api.github.com/users/MarcSerraPeralta/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MarcSerraPeralta/subscriptions","organizations_url":"https://api.github.com/users/MarcSerraPeralta/orgs","repos_url":"https://api.github.com/users/MarcSerraPeralta/repos","events_url":"https://api.github.com/users/MarcSerraPeralta/events{/privacy}","received_events_url":"https://api.github.com/users/MarcSerraPeralta/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":5,"created_at":"2025-10-19T15:54:16Z","updated_at":"2026-05-24T19:01:02Z","closed_at":"2026-05-24T19:01:02Z","assignee":{"login":"MarcSerraPeralta","id":43704266,"node_id":"MDQ6VXNlcjQzNzA0MjY2","avatar_url":"https://avatars.githubusercontent.com/u/43704266?v=4","gravatar_id":"","url":"https://api.github.com/users/MarcSerraPeralta","html_url":"https://github.com/MarcSerraPeralta","followers_url":"https://api.github.com/users/MarcSerraPeralta/followers","following_url":"https://api.github.com/users/MarcSerraPeralta/following{/other_user}","gists_url":"https://api.github.com/users/MarcSerraPeralta/gists{/gist_id}","starred_url":"https://api.github.com/users/MarcSerraPeralta/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MarcSerraPeralta/subscriptions","organizations_url":"https://api.github.com/users/MarcSerraPeralta/orgs","repos_url":"https://api.github.com/users/MarcSerraPeralta/repos","events_url":"https://api.github.com/users/MarcSerraPeralta/events{/privacy}","received_events_url":"https://api.github.com/users/MarcSerraPeralta/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Currently, my setup to track my expenses is the following:\n1. Download the bank statements on my phone for a given month\n2. Send the txt/csv files through WhatsApp to my laptop\n3. Run my Python script to classify the expenses\n4. Manually classify miscellaneous expenses\n5. Get a summary/plot of the expenses of that given month\n\nI would like to make it easier to track my expenses, and it would be nice if I could do them all from my phone. \nMy **ideal solution** would be to have a program that, every time there is a new expense, it checks if it can be automatically classified and, if not, sends me a message where I can select from a list of expense categories. \n\nHowever, I don't want to give anything access to my bank apps or any bank-related privileges. Therefore, I will not be able to do real-time tracking of my expenses (that I am aware of). The solution is the following:\n1. Create a telegram bot (much easier to set up than a Whatsapp bot) that sends me reminders on the 1st of every month to do the monthly expenses\n2. It asks for the csv/txt files and then runs the Python script to classify the expenses\n3. For every miscellaneous expense, it sends me a message with information about the expense with a choice menu where I can select an option (see \"reply keyboard\" in telegram). It also deletes the messages once the expense has been tracked (for privacy)\n4. After everything is classified, it stores the info and generates a summary/plot and sends it to me\n\nThis solution can be run from the phone (or from anything that telegram supports). ","reactions":{"url":"https://api.github.com/repos/MarcSerraPeralta/homelab/issues/18/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/MarcSerraPeralta/homelab/issues/18/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/dhairyagothi/100_days_100_web_project/issues/408","repository_url":"https://api.github.com/repos/dhairyagothi/100_days_100_web_project","labels_url":"https://api.github.com/repos/dhairyagothi/100_days_100_web_project/issues/408/labels{/name}","comments_url":"https://api.github.com/repos/dhairyagothi/100_days_100_web_project/issues/408/comments","events_url":"https://api.github.com/repos/dhairyagothi/100_days_100_web_project/issues/408/events","html_url":"https://github.com/dhairyagothi/100_days_100_web_project/issues/408","id":2775729594,"node_id":"I_kwDOLV0OQ86lckW6","number":408,"title":"Expense Tracker","user":{"login":"Peehu1308","id":145141126,"node_id":"U_kgDOCKathg","avatar_url":"https://avatars.githubusercontent.com/u/145141126?v=4","gravatar_id":"","url":"https://api.github.com/users/Peehu1308","html_url":"https://github.com/Peehu1308","followers_url":"https://api.github.com/users/Peehu1308/followers","following_url":"https://api.github.com/users/Peehu1308/following{/other_user}","gists_url":"https://api.github.com/users/Peehu1308/gists{/gist_id}","starred_url":"https://api.github.com/users/Peehu1308/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Peehu1308/subscriptions","organizations_url":"https://api.github.com/users/Peehu1308/orgs","repos_url":"https://api.github.com/users/Peehu1308/repos","events_url":"https://api.github.com/users/Peehu1308/events{/privacy}","received_events_url":"https://api.github.com/users/Peehu1308/received_events","type":"User","user_view_type":"public","